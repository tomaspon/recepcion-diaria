rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Lista de usuarios: cualquiera ve los nombres (para la pantalla de ingreso),
    // cada uno crea o edita solo su propio documento, y un usuario logueado puede quitar a otro de la lista.
    match /usuarios/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null;
    }

    // Configuración y días: solo usuarios logueados.
    match /config/{doc} {
      allow read, write: if request.auth != null;
    }
    match /dias/{fecha} {
      allow read, write: if request.auth != null;
    }
  }
}
